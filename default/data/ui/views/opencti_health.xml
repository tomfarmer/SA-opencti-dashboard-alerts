<dashboard version="1.1" theme="dark">
  <label>OpenCTI Threat Match Health</label>

  <fieldset submitButton="false">
    <input type="time" token="time">
      <label>Time range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>

  <row>
    <panel>
      <single>
        <title>Domain IOC count (KV)</title>
        <search>
          <query>| inputlookup opencti_lookup_domain | stats count</query>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>IP IOC count (KV)</title>
        <search>
          <query>| inputlookup opencti_lookup_ip | stats count</query>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Email IOC count (KV)</title>
        <search>
          <query>| inputlookup opencti_lookup_email | stats count</query>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>URL IOC count (KV)</title>
        <search>
          <query>| inputlookup opencti_lookup_url | stats count</query>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Hash IOC count (KV)</title>
        <search>
          <query>| inputlookup opencti_lookup_hash | stats count</query>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Summary events (last 24h)</title>
        <search>
          <query>index=opencti_alerts earliest=-24h | stats count</query>
        </search>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <chart>
        <title>Summary events over time</title>
        <search>
          <query>index=opencti_alerts earliest=$time.earliest$ latest=$time.latest$ | bin _time span=30m | stats count by _time sourcetype</query>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
    <panel>
      <table>
        <title>Scheduler status (last 24h)</title>
        <search>
          <query>
            index=_internal sourcetype=scheduler app=SA-OpenCTIThreatMatch earliest=-24h
            | stats latest(status) as last_status latest(_time) as last_run_epoch by savedsearch_name
            | eval last_runtime=strftime(last_run_epoch, "%H:%M %d %m %Y")
            | fields savedsearch_name last_status last_runtime
            | sort savedsearch_name
          </query>
        </search>
        <option name="count">15</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <table>
        <title>TM correlations by IOC type</title>
        <search>
          <query>
            | inputlookup opencti_tm_monitored_indexs_and_fields
            | eval enabled=coalesce(enabled,0)
            | stats count AS total, sum(enabled) AS enabled BY ioc_type
            | eval disabled=total-enabled
            | sort ioc_type
          </query>
        </search>
        <option name="count">10</option>
      </table>
    </panel>
    <panel>
      <table>
        <title>TM index usage (enabled correlations)</title>
        <search>
          <query>
            | inputlookup opencti_tm_monitored_indexs_and_fields
            | where enabled=1
            | eval idx=split(indexes,",")
            | mvexpand idx
            | rename idx AS index
            | stats count AS enabled_correlations BY ioc_type index
            | sort - enabled_correlations
          </query>
        </search>
        <option name="count">20</option>
      </table>
    </panel>
  </row>
</dashboard>
